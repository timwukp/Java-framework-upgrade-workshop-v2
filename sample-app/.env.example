# Copy to .env (git-ignored) and export before running. All values are optional.
# Leave the APP_*_PASSWORD values empty to get a generated password in the startup log.

# In-memory users
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_USER_USERNAME=user
APP_USER_PASSWORD=

# Only for SPRING_PROFILES_ACTIVE=postgres (see docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/userdb
DB_USERNAME=workshop
DB_PASSWORD=
POSTGRES_PASSWORD=
